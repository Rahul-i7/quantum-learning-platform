# Google AI Studio API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g., gemini-2.5-flash or gemini-3.7-flash)
GEMINI_MODEL=gemini-2.5-flash

# Simulation Service (Role 3 - Qiskit Aer backend)
SIMULATION_SERVICE_URL=http://localhost:8000

# Content & Progress Service (Role 5 - Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8001
