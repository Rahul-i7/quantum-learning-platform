{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-learning-platform.local/schemas/circuit.schema.json",
  "title": "QuantumCircuit",
  "description": "Shared circuit definition contract for AI-Based Interactive Quantum Algorithm Learning Platform",
  "type": "object",
  "required": ["num_qubits", "gates"],
  "properties": {
    "num_qubits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24,
      "description": "Total number of quantum wires/qubits in the circuit"
    },
    "num_classical_bits": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Number of classical bits for measurement registers"
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata such as circuit title, author, or tags",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "array",
      "description": "Ordered sequence of quantum operations and measurements",
      "items": {
        "type": "object",
        "required": ["type", "qubits"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "h",
              "x",
              "y",
              "z",
              "s",
              "sdg",
              "t",
              "tdg",
              "rx",
              "ry",
              "rz",
              "p",
              "cx",
              "cnot",
              "cz",
              "swap",
              "ccx",
              "toffoli",
              "measure",
              "barrier"
            ],
            "description": "The quantum gate type or operation identifier"
          },
          "qubits": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "description": "Indices of the qubits this gate acts upon (control qubits first, then target)"
          },
          "params": {
            "type": "array",
            "items": { "type": "number" },
            "description": "Parameters for parameterized gates like rx(theta), ry(theta), rz(theta), p(phi) in radians"
          },
          "classical_bits": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Classical bit targets for measure operations"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
